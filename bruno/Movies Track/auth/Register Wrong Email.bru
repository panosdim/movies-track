meta {
  name: Register Wrong Email
  type: http
  seq: 4
}

post {
  url: {{url}}/register
  body: json
  auth: inherit
}

body:json {
  {
      "email": "test.com",
      "password": "testpass",
      "lastName": "last name",
      "firstName": "first name"
  }
  
}

script:post-response {
  test("Status code is 422", function () {
      expect(res.getStatus()).to.equal(422);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
