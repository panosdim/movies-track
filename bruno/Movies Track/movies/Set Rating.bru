meta {
  name: Set Rating
  type: http
  seq: 6
}

post {
  url: {{url}}/movies/rate/{{movie_id}}
  body: json
  auth: inherit
}

body:json {
  {
      "rating": 4
  }
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
}
