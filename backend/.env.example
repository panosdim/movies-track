APP_ENV=development

# Database connection (used by FastAPI)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production

# TMDb API (get from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# ML Recommender
# Directory to store trained models
MODELS_DIR=./app/recommender/models
# Time of day to retrain all user models (24h HH:MM format, default 02:00)
RETRAIN_SCHEDULE_TIME=02:00

# SMTP Email Configuration (for movie release notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
