{
  "folders": [
    {
      "name": "Root",
      "path": "."
    },
    {
      "name": "Backend (FastAPI)",
      "path": "backend"
    },
    {
      "name": "Frontend (Angular)",
      "path": "frontend"
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder:Backend (FastAPI)}/.venv/Scripts/python.exe",
    "python.terminal.activateEnvironment": true,
    "[python]": {
      "editor.defaultFormatter": "ms-python.black-formatter",
      "editor.formatOnSave": true
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    "[html]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    "[scss]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    "editor.tabSize": 2,
    "files.exclude": {
      "**/node_modules": true,
      "**/__pycache__": true,
      "**/.venv": true,
      "**/*.pyc": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.venv": true,
      "**/dist": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.black-formatter",
      "ms-python.pylint",
      "charliermarsh.ruff",
      "angular.ng-template",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "bradlc.vscode-tailwindcss",
      "ms-azuretools.vscode-docker"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "FastAPI: Uvicorn",
        "type": "debugpy",
        "request": "launch",
        "module": "uvicorn",
        "args": ["app.main:app", "--reload", "--port", "8000"],
        "cwd": "${workspaceFolder:Backend (FastAPI)}",
        "python": "${workspaceFolder:Backend (FastAPI)}/.venv/Scripts/python.exe",
        "console": "integratedTerminal"
      },
      {
        "name": "Angular: ng serve",
        "type": "chrome",
        "request": "launch",
        "preLaunchTask": "ng serve",
        "url": "http://localhost:4200",
        "webRoot": "${workspaceFolder:Frontend (Angular)}/src"
      }
    ],
    "compounds": [
      {
        "name": "Full Stack",
        "configurations": ["FastAPI: Uvicorn", "Angular: ng serve"]
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "backend: start",
        "type": "shell",
        "command": ".venv/Scripts/uvicorn app.main:app --reload --port 8000",
        "options": {
          "cwd": "${workspaceFolder:Backend (FastAPI)}"
        },
        "group": "build",
        "presentation": {
          "panel": "dedicated",
          "reveal": "always"
        }
      },
      {
        "label": "frontend: start",
        "type": "shell",
        "command": "npm start",
        "options": {
          "cwd": "${workspaceFolder:Frontend (Angular)}"
        },
        "group": "build",
        "presentation": {
          "panel": "dedicated",
          "reveal": "always"
        }
      },
      {
        "label": "ng serve",
        "type": "shell",
        "command": "ng serve",
        "options": {
          "cwd": "${workspaceFolder:Frontend (Angular)}"
        },
        "isBackground": true,
        "problemMatcher": {
          "owner": "typescript",
          "pattern": "$tsc",
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Building...",
            "endsPattern": "compiled|failed"
          }
        }
      }
    ]
  }
}
